# ────────────────────────────────────────────────────────────────
# Craftloop — Environment Variables Reference
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
# Use the "pooled" connection string for the API server.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Session ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── Admin access key ──────────────────────────────────────────────
# This key must appear as ?key=VALUE in the admin login URL.
# Example: https://yourdomain.com/admin/login?key=my-secret-key
# Set the same value in both ADMIN_ACCESS_KEY (server) and
# VITE_ADMIN_KEY (Vercel frontend env var).
ADMIN_ACCESS_KEY=replace-with-your-admin-access-key

# ── Vercel frontend only ──────────────────────────────────────────
# Must match ADMIN_ACCESS_KEY above.
VITE_ADMIN_KEY=replace-with-your-admin-access-key

# ── CORS (production API server only) ────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://yourapp.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=https://yourapp.vercel.app,https://yourdomain.com

# ── Email / SMTP ──────────────────────────────────────────────────
# Supports any SMTP provider (Gmail, Resend, Mailgun, SendGrid, etc.)
#
# Gmail example (use an App Password, not your real password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Trivinex Partners <no-reply@yourdomain.com>"

# ────────────────────────────────────────────────────────────────
# Deployment Quick-Start
# ────────────────────────────────────────────────────────────────
#
# 1. DATABASE — Neon (https://neon.tech)
#    - Create a free project
#    - Copy the "pooled" connection string → DATABASE_URL
#    - Run schema: pnpm --filter @workspace/db run push
#    - Seed: pnpm --filter @workspace/api-server exec tsx src/scripts/seed.ts
#
# 2. API SERVER — Railway (https://railway.app)
#    - New project → Deploy from GitHub repo
#    - Set root directory: (leave as root — railway.toml handles build)
#    - Add all env vars from this file (DATABASE_URL, SESSION_SECRET, etc.)
#    - Copy the Railway public URL → use in ALLOWED_ORIGINS + vercel.json rewrite
#
# 3. FRONTEND — Vercel (https://vercel.com)
#    - Import GitHub repo
#    - Set root directory to: artifacts/craftloop
#    - Framework preset: Vite
#    - Build command: cd ../.. && pnpm install && pnpm --filter @workspace/craftloop run build
#    - Output dir: dist/public
#    - Add env vars: VITE_ADMIN_KEY
#    - In vercel.json, replace REPLACE_WITH_RAILWAY_API_URL with your Railway URL
#
# Default admin credentials (change after first login):
#   Email: admin@craftloop.app
#   Password: Craftloop!Admin1
#   Login URL: https://yourdomain.com/admin/login?key=YOUR_ADMIN_ACCESS_KEY
# ────────────────────────────────────────────────────────────────
